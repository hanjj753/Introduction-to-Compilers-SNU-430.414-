{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Project 1: build",
      "type": "process",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}/projects/project1"
      },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/projects/project1/src"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
